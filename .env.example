# Copier vers .env.local (développement) ou saisir dans Vercel > Settings > Environment Variables.
# Ne jamais committer de valeur réelle.

# --- Base PostgreSQL (Supabase : chaîne « Transaction pooler », port 6543)
DATABASE_URL=postgres://utilisateur:motdepasse@hote:6543/postgres
# DATABASE_SSL=no-verify      # seulement si le certificat du fournisseur n'est pas reconnu
# DATABASE_POOL_MAX=5

# --- Sessions (32 caractères aléatoires minimum : openssl rand -base64 48)
AUTH_SECRET=
# Adresse publique du site (obligatoire en production, ex. https://parc.exemple.fr)
APP_URL=

# --- Connexion Google des utilisateurs (client OAuth « Application Web »)
# URI de redirection autorisée : <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Dépôt Google Drive : oauth | service_account | mock (développement uniquement)
# Le dossier « VEHICULES GUYANE » est dans « Mon Drive » : utiliser oauth.
DRIVE_MODE=oauth
# oauth : le compte Google GSET autorisé se connecte depuis Administration > Compte Google Drive.
# Son jeton est stocké chiffré en base. Ajouter au client OAuth l'URI <APP_URL>/api/drive/oauth/callback.
# Facultatif : client OAuth distinct pour Drive (sinon GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET sont utilisés).
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# service_account (Drive partagé uniquement) : contenu JSON de la clé, brut ou en base64
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Tâche planifiée Vercel (envois Drive) : chaîne aléatoire
CRON_SECRET=

# --- Premier administrateur créé par « npm run seed »
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# --- Fuseau d'affichage, du planning et des noms de fichiers
NEXT_PUBLIC_APP_TIMEZONE=America/Cayenne
# Premier mois du planning mensuel (classeur : novembre 2026)
# PLANNING_START_MONTH=2026-11

# --- Développement uniquement (ignorés / interdits en production Vercel)
# AUTH_DEV_LOGIN=true
# SEED_DEMO_USERS=true
